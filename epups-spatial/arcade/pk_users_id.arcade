// Constraint on users: UserID must be unique.
var self = IIf(IsEmpty($feature.OBJECTID), -1, $feature.OBJECTID)
var others = Filter(
  FeatureSetByName($datastore, "users", ["UserID", "OBJECTID"], false),
  "UserID = " + Text($feature.UserID) + " AND OBJECTID <> " + Text(self)
)
return Count(others) == 0
